APP_ENV=development
APP_NAME=India AI Financial Analyst
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Database / auth
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=

# Provider endpoints/models are configurable so code is not tied to one model release
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
# Optional separate Gemini model for page-level chart/table/image interpretation.
GEMINI_MULTIMODAL_MODEL=
# Separate audio-understanding model so transcription can be upgraded independently.
GEMINI_AUDIO_MODEL=gemini-3.7-flash

# Cost policy. Routes marked paid are never selected while FREE_ONLY=true.
FREE_ONLY=true
GROQ_ROUTE_COST=free
GEMINI_ROUTE_COST=free
NVIDIA_ROUTE_COST=free
CEREBRAS_ROUTE_COST=free
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=2
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
# Hard per-research-job budget shared by all enrichment/synthesis LLM calls and fallbacks.
LLM_MAX_CALLS_PER_JOB=10
LLM_MAX_RESERVED_TOKENS_PER_JOB=24000

# Search / macro / market-data fallbacks
TAVILY_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
FRED_BASE_URL=https://api.stlouisfed.org/fred
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# India live market adapters — configure one or more
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_TOTP_SECRET=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must exactly match the callback URI registered in the Upstox developer app.
UPSTOX_REDIRECT_URI=http://localhost:8000/v1/brokers/upstox/callback
# Server-only Fernet key for encrypting broker access/refresh tokens at rest.
# Generate independently per environment; never expose as NEXT_PUBLIC_* or commit its value.
BROKER_TOKEN_ENCRYPTION_KEY=
BROKER_OAUTH_STATE_TTL_SECONDS=600
# Optional operator-only credential for global historical-data backfills. This is intentionally
# separate from per-user encrypted OAuth connections and is read only by backfill scripts.
UPSTOX_DATA_ACCESS_TOKEN=

# Monitoring
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Runtime safeguards
# Keep provider/network switches false until secure environment variables and accounts are ready.
ENABLE_LIVE_MARKET=false
ENABLE_EXTERNAL_LLM_CALLS=false
ENABLE_EXTERNAL_DATA_CALLS=false
# Selective background event research stays off until the real production corpus is ready.
ENABLE_EVENT_RESEARCH=false
# Local semantic retrieval uses a local Sentence-Transformers model and the existing pgvector DB.
# Enable only on runtimes built with the embeddings extra; no paid embedding API is required.
ENABLE_SEMANTIC_RETRIEVAL=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
SEMANTIC_EVIDENCE_MIN_SIMILARITY=0.30
SEMANTIC_EVIDENCE_MAX_CHUNKS=24
SEMANTIC_EVIDENCE_PER_QUERY=6
# Optional page-level Gemini analysis for visually rich result/presentation/annual-report pages.
# Findings are stored as ai_extraction evidence and can never become verified primary facts alone.
ENABLE_MULTIMODAL_DOCUMENT_ANALYSIS=false
MULTIMODAL_MAX_PAGES_PER_DOCUMENT=4
MULTIMODAL_MAX_INLINE_BYTES=12000000
# Optional earnings/investor audio transcription. Transcript chunks remain secondary evidence and
# raw audio bytes are not persisted by the ingestion layer.
ENABLE_AUDIO_TRANSCRIPTION=false
AUDIO_TRANSCRIPTION_MAX_INLINE_BYTES=12000000
AUDIO_TRANSCRIPTION_MAX_OUTPUT_TOKENS=16000
AUDIO_TRANSCRIPT_CHUNK_CHARS=3200
# Fresh Tavily research is cache-first so repeated analysis does not waste API credits.
WEB_RESEARCH_CACHE_SECONDS=900
WEB_RESEARCH_MAX_SEARCHES_PER_JOB=2
WEB_RESEARCH_MAX_RESULTS_PER_SEARCH=5
MAX_AGENT_CONCURRENCY=6
MAX_RESEARCH_JOB_SECONDS=240
RESEARCH_WORKER_POLL_SECONDS=1.0
OFFICIAL_FEED_POLL_SECONDS=60
OFFICIAL_FEED_BATCH_SIZE=4

# Per-user Upstox V3 stream lifecycle. The research API only renews subscriptions and reads
# sanitized rows; the dedicated live-market worker owns the broker websocket connections.
LIVE_MARKET_SUBSCRIPTION_TTL_SECONDS=1200
LIVE_MARKET_QUOTE_FRESH_SECONDS=15
LIVE_MARKET_WORKER_POLL_SECONDS=5
LIVE_MARKET_STREAM_LEASE_SECONDS=45
LIVE_MARKET_STREAM_HEARTBEAT_SECONDS=15
LIVE_MARKET_SUBSCRIPTION_REFRESH_SECONDS=10
LIVE_MARKET_MAX_USER_STREAMS=10
LIVE_MARKET_DB_FLUSH_SECONDS=1.0
