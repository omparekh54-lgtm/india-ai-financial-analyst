# Core
APP_ENV=development
APP_NAME=India AI Financial Analyst
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database / Supabase
# Server-side values: never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Browser-safe Supabase values used only for user authentication.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LLM providers — secrets must only be set in local/deployment environments
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=

# Provider endpoints/models are configurable so code is not tied to one model release
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash

# Search / macro / market-data fallbacks
TAVILY_API_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
FRED_BASE_URL=https://api.stlouisfed.org/fred
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# India live market adapters — configure one or more
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_TOTP_SECRET=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# Monitoring
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Runtime safeguards
# Keep all three false until secure environment variables and provider accounts are ready.
ENABLE_LIVE_MARKET=false
ENABLE_EXTERNAL_LLM_CALLS=false
ENABLE_EXTERNAL_DATA_CALLS=false
MAX_AGENT_CONCURRENCY=6
MAX_RESEARCH_JOB_SECONDS=240
OFFICIAL_FEED_POLL_SECONDS=60
OFFICIAL_FEED_BATCH_SIZE=4
