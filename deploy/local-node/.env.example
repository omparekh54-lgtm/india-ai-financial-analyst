# Local research node: research worker + daily shared-market refresh.
# Copy to .env and fill in. Never commit the filled-in file.

APP_ENV=production
LOG_LEVEL=INFO

# Required: the same Supabase Postgres connection string the API uses.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for on-demand fetching of a requested stock's data.
ENABLE_EXTERNAL_DATA_CALLS=true

# News, Web, Sentiment and Risk agents need fresh web/news acquisition.
TAVILY_API_KEY=

# Optional but recommended: better-written reports. Any one free key is enough.
ENABLE_EXTERNAL_LLM_CALLS=false
GROQ_API_KEY=
GEMINI_API_KEY=
FREE_ONLY=true

# Official classification accepted by the Industry Agent. Keep the strict default when this
# machine passes scripts/check_nse_reachability.py.
CLASSIFICATION_POLICY=nse_four_tier

# One job at a time keeps NSE request volume low from a home connection. A first fetch for
# a new stock can take several minutes; keep this high so it is not requeued mid-fetch.
MAX_RESEARCH_JOB_SECONDS=900
MAX_AGENT_CONCURRENCY=4

# Optional: report worker errors to Sentry.
SENTRY_DSN=
